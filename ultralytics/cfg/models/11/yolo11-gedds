# Ultralytics YOLO 🚀
# YOLO11-GED-DS (Ghost + EMA + DySample + Dynamic Snake Conv)
# Optimized specifically for industrial fastener detection (threads, bolts, screws)

nc: 80  # number of classes

scale: m

scales:
  n: [0.50, 0.25, 1024]
  s: [0.50, 0.50, 1024]
  m: [0.75, 0.75, 768]

backbone:
  # P1: Low-level spatial features (Edges)
  - [-1, 1, Conv, [64, 3, 2]]             # 0

  # P2
  - [-1, 1, Conv, [128, 3, 2]]            # 1
  - [-1, 2, C2f, [128, True]]             # 2

  # P3: Medium resolution (Fine fastener threads start appearing here)
  - [-1, 1, Conv, [256, 3, 2]]            # 3
  - [-1, 2, DSConvC2fEMA, [256, True]]    # 4 

  # P4: High resolution (Complex thread patterns and head geometry)
  - [-1, 1, Conv, [512, 3, 2]]            # 5
  - [-1, 3, DSConvC2fEMA, [512, True]]    # 6 

  # P5: Semantic context (Global shape)
  - [-1, 1, Conv, [1024, 3, 2]]           # 7
  - [-1, 3, EMAc2f, [1024, True]]         # 8 

  # SPPF
  - [-1, 1, SPPF, [1024, 5]]              # 9

head:

  # ---------- P5 → P4 Fusion ----------
  - [-1, 1, DySample, [2]]                # 10 
  - [[-1, 6], 1, Concat, [1]]             # 11
  - [-1, 3, DSConvC2fEMA, [512]]          # 12 

  # ---------- P4 → P3 Fusion ----------
  - [-1, 1, DySample, [2]]                # 13 
  - [[-1, 4], 1, Concat, [1]]             # 14
  - [-1, 3, DSConvC2fEMA, [256]]          # 15 

  # ---------- Bottom-up (P3 → P4) ----------
  - [-1, 1, Conv, [256, 3, 2]]            # 16
  - [[-1, 12], 1, Concat, [1]]            # 17
  - [-1, 3, DSConvC2fEMA, [512]]          # 18 

  # ---------- Bottom-up (P4 → P5) ----------
  - [-1, 1, Conv, [512, 3, 2]]            # 19
  - [[-1, 9], 1, Concat, [1]]             # 20
  - [-1, 3, EMAc2f, [1024]]               # 21 

  # ---------- Detection ----------
  - [[15, 18, 21], 1, Detect, [nc]]       # 22 
